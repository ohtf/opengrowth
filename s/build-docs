# Build the documentation site into site/, as CI does. Pass --strict to fail on
# any warning, as CI does.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [[ -x .venv/bin/zensical ]]; then
  zensical=.venv/bin/zensical
else
  zensical=zensical
fi
exec "$zensical" build --clean "$@"
