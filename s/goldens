# Regenerate conformance/expected/ from the pinned Python reference environments.
# Goldens are never hand-edited; commit the regenerated files with a rationale.
# http_* generators run in the reference server environment (s/reference-server).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
venv="${OPENGROWTH_REFERENCE_VENV:-$HOME/.cache/opengrowth/reference-python}"
server="${OPENGROWTH_REFERENCE_SERVER:-$HOME/.cache/opengrowth/reference-server}"
generators=("$@")
[[ ${#generators[@]} -gt 0 ]] || generators=(uk_who_r_vectors normal_grid python_round numpy_round python_repr python_timedelta http_uk_who http_who http_uk_who_charts http_who_charts http_uk_who_fictional_child http_who_fictional_child http_utilities_mid_parental_height)
cd "$root/conformance/generators"
for name in "${generators[@]}"; do
  if [[ "$name" == http_* ]]; then
    [[ -x "$server/venv/bin/python" ]] || { echo "No reference server at $server; run s/reference-server" >&2; exit 1; }
    OPENGROWTH_REFERENCE_SERVER_SRC="$server/src" "$server/venv/bin/python" "$name.py"
  else
    [[ -x "$venv/bin/python" ]] || { echo "No reference environment at $venv; run s/reference-python" >&2; exit 1; }
    "$venv/bin/python" "$name.py"
  fi
done
