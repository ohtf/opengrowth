# Fail if docs/differences.md does not name every difference from the upstream
# server that a conformance test allows (R53). --list prints them all.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 -I "$root/qms/tools/differences.py" "$@"
