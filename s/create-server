#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Open Health Technology Foundation contributors
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Create the demo server on Hetzner Cloud (R58), once:
#
#   s/create-server ADMIN_KEY.pub DEPLOY_KEY.pub
#
# ADMIN_KEY.pub is your own key, whose private half can be in an SSH agent,
# such as a password manager's, or on disk beside it. DEPLOY_KEY.pub is the
# deploy workflow's. The script makes a firewall that admits SSH, HTTP, HTTPS,
# and ping, then a CX23 in Helsinki, or a CPX02 if Hetzner has no CX23 to
# sell, running Ubuntu 26.04 and set up on first boot by
# deploy/cloud-init.yaml. It waits for that setup, restarts the server if its
# updates need it, adds the server's host key to your known_hosts, and prints
# the DNS records to create and the deploy workflow's DEPLOY_KNOWN_HOSTS line.
#
# It uses only the hcloud context named `ohtf`. Create that once with
# `hcloud context create ohtf`, pasting the OHTF project's API token when it
# asks, so that the token never appears on a command line.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

name="api.openhealthtechnology.org"
location="hel1"
server_types=(cx23 cpx02)
image="ubuntu-26.04"
firewall="opengrowth-web"

[[ $# -eq 2 ]] || { echo "usage: s/create-server ADMIN_KEY.pub DEPLOY_KEY.pub" >&2; exit 2; }
admin_key="$1"
deploy_key="$2"
for key in "$admin_key" "$deploy_key"; do
  [[ "$key" == *.pub && -f "$key" ]] || { echo "not a public key file: $key" >&2; exit 1; }
done
command -v hcloud >/dev/null || { echo "hcloud not found: https://github.com/hetznercloud/cli#installation" >&2; exit 1; }
hcloud context list -o noheader -o columns=name | grep --quiet --line-regexp ohtf \
  || { echo "no hcloud context named ohtf: run hcloud context create ohtf" >&2; exit 1; }
hc() { hcloud --context ohtf "$@"; }

if hc server describe "$name" >/dev/null 2>&1; then
  echo "a server named $name already exists in this project" >&2
  exit 1
fi
hc image list --type system -o noheader -o columns=name | grep --quiet --line-regexp "$image" \
  || { echo "Hetzner offers no $image image: see hcloud --context ohtf image list --type system" >&2; exit 1; }

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

# Given a key, Hetzner sets no root password; cloud-init then closes root
# logins anyway.
admin_name="$(basename "${admin_key%.pub}")"
hc ssh-key describe "$admin_name" >/dev/null 2>&1 \
  || hc ssh-key create --name "$admin_name" --public-key-from-file "$admin_key" >/dev/null

if ! hc firewall describe "$firewall" >/dev/null 2>&1; then
  cat > "$scratch/rules.json" <<'JSON'
[
  {"direction": "in", "protocol": "tcp", "port": "22", "source_ips": ["0.0.0.0/0", "::/0"], "description": "SSH"},
  {"direction": "in", "protocol": "tcp", "port": "80", "source_ips": ["0.0.0.0/0", "::/0"], "description": "HTTP, for redirects and certificates"},
  {"direction": "in", "protocol": "tcp", "port": "443", "source_ips": ["0.0.0.0/0", "::/0"], "description": "HTTPS"},
  {"direction": "in", "protocol": "udp", "port": "443", "source_ips": ["0.0.0.0/0", "::/0"], "description": "HTTP/3"},
  {"direction": "in", "protocol": "icmp", "source_ips": ["0.0.0.0/0", "::/0"], "description": "ping"}
]
JSON
  hc firewall create --name "$firewall" --rules-file "$scratch/rules.json" >/dev/null
fi

# The keys go in as quoted strings, so that a key's comment cannot change the
# YAML around it.
python3 -I - "$admin_key" "$deploy_key" > "$scratch/user-data.yaml" <<'PYTHON'
import json, sys
keys = [open(name).read().strip() for name in sys.argv[1:3]]
for key in keys:
    if "\n" in key or not key.split()[0].startswith(("ssh-", "ecdsa-", "sk-")):
        sys.exit(f"not an SSH public key: {key[:40]}")
text = open("deploy/cloud-init.yaml").read()
for placeholder, key in zip(("__ADMIN_KEY__", "__DEPLOY_KEY__"), keys):
    if text.count(placeholder) != 1:
        sys.exit(f"deploy/cloud-init.yaml should have {placeholder} once")
    text = text.replace(placeholder, json.dumps(key))
print(text, end="")
PYTHON

created=""
for server_type in "${server_types[@]}"; do
  echo "creating $name: $server_type in $location, $image" >&2
  if hc server create --name "$name" --type "$server_type" --location "$location" --image "$image" \
    --ssh-key "$admin_name" --firewall "$firewall" --user-data-from-file "$scratch/user-data.yaml" \
    --label project=opengrowth --label role=demo >/dev/null; then
    created="$server_type"
    break
  fi
  echo "could not create a $server_type; trying the next size" >&2
done
[[ -n "$created" ]] || { echo "Hetzner could create none of: ${server_types[*]}" >&2; exit 1; }
ipv4="$(hc server ip "$name")"
ipv6="$(hc server ip --ipv6 "$name")"

# The first connection records the host key, which the rest then check.
identity="$admin_key"
if [[ -f "${admin_key%.pub}" ]]; then
  identity="${admin_key%.pub}"
fi
remote() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 -o IdentitiesOnly=yes -i "$identity" \
    -o HostKeyAlgorithms=ssh-ed25519 -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile="$scratch/known_hosts" -o HashKnownHosts=no \
    "deploy@$ipv4" "$@"
}
wait_for_ssh() {
  for _ in $(seq 60); do
    remote true 2>/dev/null && return 0
    sleep 10
  done
  echo "$name ($ipv4) did not accept SSH within 10 minutes" >&2
  exit 1
}

echo "waiting for $ipv4 to accept SSH" >&2
wait_for_ssh
echo "waiting for its first-boot setup to finish" >&2
status="$(remote 'cloud-init status --wait >/dev/null 2>&1; cloud-init status' || true)"
if [[ "$status" != *"status: done"* ]]; then
  echo "its first-boot setup did not finish: ${status:-no status}" >&2
  remote 'sudo tail -n 30 /var/log/cloud-init-output.log' >&2 || true
  exit 1
fi
if remote 'test -f /var/run/reboot-required'; then
  echo "restarting it to finish installing updates" >&2
  remote 'sudo systemctl reboot' >/dev/null 2>&1 || true
  sleep 20
  wait_for_ssh
fi
docker_version="$(remote 'test -w /srv/opengrowth && docker version --format {{.Server.Version}}')" \
  || { echo "the deploy user cannot use Docker or /srv/opengrowth: see /var/log/cloud-init-output.log" >&2; exit 1; }
compose_version="$(remote 'docker compose version --short')"

known="$(awk -v names="$name,$ipv4" 'NR == 1 { $1 = names; print }' "$scratch/known_hosts")"
[[ -n "$known" ]] || { echo "no host key was recorded for $ipv4" >&2; exit 1; }
ssh-keygen -R "$name" >/dev/null 2>&1 || true
ssh-keygen -R "$ipv4" >/dev/null 2>&1 || true
printf '%s\n' "$known" >> ~/.ssh/known_hosts

cat <<EOF

Created $name: a $created in $location, running $image, with Docker $docker_version and Compose $compose_version.

Create these DNS records, not proxied, so that Caddy can obtain its certificate:
  $name.  A     $ipv4
  $name.  AAAA  $ipv6

Its host key is now in ~/.ssh/known_hosts. The deploy workflow's DEPLOY_KNOWN_HOSTS secret is:
$known
EOF
