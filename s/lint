# Format check and clippy, for the default build and the engine alone, as CI runs them.
set -euo pipefail
cargo fmt --all --check
cargo clippy --all-targets "$@" -- -D warnings
exec cargo clippy --all-targets --no-default-features "$@" -- -D warnings
