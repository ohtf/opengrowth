# TLS for the demo server, in front of APISIX, under the /growth/v1 prefix
# that the RCPCH API uses, so that an RCPCH client needs only a new host.
# APISIX strips the prefix and limits each client's requests; Caddy tells it
# the client's address in X-Forwarded-For, which a client cannot set itself.

{$SITE_ADDRESS} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	redir /growth/v1 /growth/v1/ 308

	handle /growth/v1/* {
		reverse_proxy apisix:9080 {
			# opengrowth redirects a path with a trailing slash as the RCPCH
			# server does, to http:// and without the prefix; send the client
			# to the public address instead.
			header_down Location "^http://[^/]+/" "https://{host}/growth/v1/"
			header_down -Server
		}
	}

	handle {
		header Content-Type application/json
		respond `{"detail":"Not Found"}` 404
	}
}
